ENVIRONMENT=development
PORT=8080
DEEPSEEK_API_KEY=your-deepseek-api-key
OLLAMA_BASE_URL=http://localhost:11434
CV_CLEANUP_PROVIDER=deepseek
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cv_evaluator
DB_USER=postgres
DB_PASSWORD=postgres
# disable for the docker-compose Postgres; require (the default outside
# development) or verify-full for a hosted database such as Neon.
DB_SSLMODE=disable
# Outside development: at least 32 bytes, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-with-a-long-random-value
# Optional. Shares rate limits across API replicas, e.g. redis://default:pw@localhost:6379/0
REDIS_URL=
# Optional. Proxy IPs/CIDRs whose X-Forwarded-For is trusted (e.g. 10.42.0.0/16 on k3s).
TRUSTED_PROXIES=
# Set to false when a separate `cv-api migrate` step runs migrations.
MIGRATE_ON_START=true
# OpenTelemetry (optional). Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable export.
# Locally, `docker compose up` runs otel-lgtm: use http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
SERVICE_VERSION=dev
