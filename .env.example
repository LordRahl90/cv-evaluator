ENVIRONMENT=development
PORT=8080
DEEPSEEK_API_KEY=your-deepseek-api-key
OLLAMA_BASE_URL=http://localhost:11434
CV_CLEANUP_PROVIDER=deepseek
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cv_evaluator
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=change-me-with-a-long-random-value
# OpenTelemetry (optional). Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable export.
# Locally, `docker compose up` runs otel-lgtm: use http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
SERVICE_VERSION=dev
